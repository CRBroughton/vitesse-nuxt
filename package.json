{
  "name": "vitesse-nuxt-monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter main --filter docs dev",
    "dev:pwa": "pnpm --filter main dev:pwa",
    "dev:docs": "pnpm --filter docs dev",
    "build:docs": "pnpm --filter docs build",
    "generate": "pnpm --filter main generate",
    "preview": "pnpm --filter main preview",
    "start": "pnpm --filter main start",
    "start:generate": "pnpm --filter main start:generate",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "deps:check": "pnpx taze",
    "deps:update": "pnpx taze -I"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "resolutions": {
    "@nuxt/devtools": "catalog:build",
    "@nuxt/kit": "catalog:build",
    "nuxt": "catalog:build",
    "unplugin": "catalog:build",
    "vite": "catalog:build"
  }
}